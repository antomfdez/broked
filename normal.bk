// normal.bk - NORMAL mode: motions, operators (d/c/y + motion), counts,
// registers, and entry into the other modes.

#include "editor.bk"

// Delete `n` whole lines at the cursor into the yank register.
U0 EdDeleteLines(Ed e, I64 n)
{
  EdPushUndo(e);
  I64 avail = Len(e.lines) - e.cy;
  if (n > avail) n = avail;
  e.yank = ArrSlice(e.lines, e.cy, n);
  e.yankline = TRUE;
  e.lines = LinesRemoveAt(e.lines, e.cy, n);
  if (e.cy > Len(e.lines) - 1) e.cy = Len(e.lines) - 1;
  e.cx = LineFirstNonBlank(EdCurLine(e));
  e.dirty = TRUE;
}

U0 EdYankLines(Ed e, I64 n)
{
  I64 avail = Len(e.lines) - e.cy;
  if (n > avail) n = avail;
  e.yank = ArrSlice(e.lines, e.cy, n);
  e.yankline = TRUE;
  EdSetStatus(e, ToStr(n) + " line(s) yanked");
}

// cc - replace `n` lines with one empty line and enter insert mode.
U0 EdChangeLines(Ed e, I64 n)
{
  EdPushUndo(e);
  I64 avail = Len(e.lines) - e.cy;
  if (n > avail) n = avail;
  e.yank = ArrSlice(e.lines, e.cy, n);
  e.yankline = TRUE;
  I64 before = Len(e.lines);
  e.lines = LinesRemoveAt(e.lines, e.cy, n);
  if (before - n > 0) e.lines = LinesInsertAt(e.lines, e.cy, "");
  e.cx = 0;
  e.wantx = 0;
  e.mode = M_INSERT;
  e.dirty = TRUE;
}

// x / X - delete chars on the current line into the register (charwise).
U0 EdDeleteChars(Ed e, I64 at, I64 n)
{
  U8 line = EdCurLine(e);
  if (Len(line) == 0) return;
  if (at < 0) { n = n + at; at = 0; }
  if (at + n > Len(line)) n = Len(line) - at;
  if (n <= 0) return;
  EdPushUndo(e);
  e.yank = [Substr(line, at, n)];
  e.yankline = FALSE;
  e.lines[e.cy] = LineRemoveRange(line, at, n);
  e.cx = at;
  EdClampX(e);
  e.dirty = TRUE;
}

// Apply operator op ("d" | "y" | "c") over a charwise motion starting at
// the cursor. Motions that cross a line boundary clamp the range to the
// start line (the linewise dj/dk forms are not supported). As in vim,
// cw on a word acts like ce.
U0 EdOpMotion(Ed e, U8 op, I64 k, I64 rep)
{
  U8 line = EdCurLine(e);
  I64 sx = e.cx;
  I64 sy = e.cy;
  I64 mk = k;
  if (op == "c" && k == 'w' && sx < Len(line)
      && ChClass(CharAt(line, sx)) != 0)
    mk = 'e';
  I64 ex = 0;
  Bool valid = TRUE;
  Bool inclusive = FALSE;
  // Let motions step one past EOL while an operator is pending.
  I64 om = e.mode;
  e.mode = M_INSERT;
  I64 i = 0;
  if (mk == 'w')      { for (i = 0; i < rep; ++i) EdWordFwd(e);  ex = e.cx; }
  else if (mk == 'b') { for (i = 0; i < rep; ++i) EdWordBack(e); ex = e.cx; }
  else if (mk == 'e') {
    for (i = 0; i < rep; ++i) EdWordEnd(e);
    ex = e.cx;
    inclusive = TRUE;
  }
  else if (mk == '$') { ex = Len(line); }
  else if (mk == '0') { ex = 0; }
  else if (mk == '^') { ex = LineFirstNonBlank(line); }
  else if (mk == 'h') { ex = sx - rep; }
  else if (mk == 'l') { ex = sx + rep; }
  else valid = FALSE;
  if (inclusive) ex = ex + 1;
  if (e.cy > sy) ex = Len(line);
  if (e.cy < sy) ex = 0;
  e.cy = sy;
  e.cx = sx;
  e.mode = om;
  if (!valid) return;
  if (ex < 0) ex = 0;
  if (ex > Len(line)) ex = Len(line);
  I64 lo = sx;
  I64 hi = ex;
  if (hi < lo) { lo = ex; hi = sx; }
  if (op == "y") {
    if (hi > lo) {
      e.yank = [Substr(line, lo, hi - lo)];
      e.yankline = FALSE;
    }
    e.cx = lo;
    e.wantx = lo;
    return;
  }
  // d / c: set the target mode first so the cursor clamp is right
  // (c at EOL must leave the cursor one past the last char).
  if (op == "c") e.mode = M_INSERT;
  if (hi > lo) EdDeleteChars(e, lo, hi - lo);
  else if (op == "c") EdPushUndo(e);
  e.wantx = e.cx;
}

// p / P - paste the register after (below) or at (above) the cursor.
U0 EdPaste(Ed e, Bool after)
{
  if (Len(e.yank) == 0) return;
  EdPushUndo(e);
  if (e.yankline) {
    I64 at = e.cy;
    if (after) at = e.cy + 1;
    I64 i = 0;
    for (i = 0; i < Len(e.yank); ++i)
      e.lines = LinesInsertAt(e.lines, at + i, e.yank[i]);
    e.cy = at;
    e.cx = LineFirstNonBlank(EdCurLine(e));
  } else if (Len(e.yank) == 1) {
    U8 line = EdCurLine(e);
    I64 at = e.cx;
    if (after && Len(line) > 0) at = e.cx + 1;
    e.lines[e.cy] = LineInsertStr(line, at, e.yank[0]);
    e.cx = at + Len(e.yank[0]) - 1;
  } else {
    // Charwise multi-line fragments: first joins the left half, the rest
    // are whole lines except the last, which joins the right half.
    U8 line = EdCurLine(e);
    I64 at = e.cx;
    if (after && Len(line) > 0) at = e.cx + 1;
    U8 left = Substr(line, 0, at);
    U8 right = Substr(line, at, Len(line) - at);
    e.lines[e.cy] = left + e.yank[0];
    I64 i = 0;
    for (i = 1; i < Len(e.yank) - 1; ++i)
      e.lines = LinesInsertAt(e.lines, e.cy + i, e.yank[i]);
    I64 last = Len(e.yank) - 1;
    e.lines = LinesInsertAt(e.lines, e.cy + last, e.yank[last] + right);
    e.cx = at;
  }
  EdClampX(e);
  e.dirty = TRUE;
}

// J - join the next line onto this one with a single space.
U0 EdJoin(Ed e)
{
  if (e.cy >= Len(e.lines) - 1) return;
  EdPushUndo(e);
  U8 cur = StrTrimRight(EdCurLine(e));
  U8 next = StrTrimLeft(e.lines[e.cy + 1]);
  U8 joined = cur;
  if (Len(cur) > 0 && Len(next) > 0) joined = cur + " " + next;
  else joined = cur + next;
  e.lines[e.cy] = joined;
  e.lines = LinesRemoveAt(e.lines, e.cy + 1, 1);
  e.cx = Len(cur);
  EdClampX(e);
  e.dirty = TRUE;
}

// o / O - open a line below/above and enter insert mode.
U0 EdOpenLine(Ed e, Bool below)
{
  EdPushUndo(e);
  I64 at = e.cy;
  if (below) at = e.cy + 1;
  e.lines = LinesInsertAt(e.lines, at, "");
  e.cy = at;
  e.cx = 0;
  e.mode = M_INSERT;
  e.dirty = TRUE;
}

U0 EdEnterInsert(Ed e, I64 atx)
{
  EdPushUndo(e);
  e.mode = M_INSERT;
  e.cx = atx;
  EdClampX(e);
}

// Resolve a pending two-key sequence: dd/cc/yy, d/c/y + motion, gg, r<c>,
// ZZ. Returns TRUE when the key was consumed by the pending state machine.
Bool EdPendingKey(Ed e, I64 k, I64 rep)
{
  U8 p = e.pending;
  if (p == "") return FALSE;
  e.pending = "";
  if (p == "r") {
    if (k >= 32 && k <= 126 && Len(EdCurLine(e)) > 0) {
      EdPushUndo(e);
      U8 line = EdCurLine(e);
      e.lines[e.cy] = Substr(line, 0, e.cx) + Chr(k)
                    + Substr(line, e.cx + 1, Len(line) - e.cx - 1);
      e.dirty = TRUE;
    }
    return TRUE;
  }
  if (p == "d" || p == "y" || p == "c") {
    if (p == "d" && k == 'd') { EdDeleteLines(e, rep); return TRUE; }
    if (p == "y" && k == 'y') { EdYankLines(e, rep); return TRUE; }
    if (p == "c" && k == 'c') { EdChangeLines(e, rep); return TRUE; }
    EdOpMotion(e, p, k, rep);
    return TRUE;
  }
  if (p == "g") {
    if (k == 'g') {
      e.cy = rep - 1;
      if (e.count == 0) e.cy = 0;
      if (e.cy > Len(e.lines) - 1) e.cy = Len(e.lines) - 1;
      e.cx = LineFirstNonBlank(EdCurLine(e));
      e.wantx = e.cx;
    }
    return TRUE;
  }
  if (p == "Z") {
    if (k == 'Z') { if (EdSave(e)) e.quit = TRUE; }
    return TRUE;
  }
  return TRUE;
}

U0 EdNormalKey(Ed e, I64 k)
{
  I64 rep = e.count;
  if (rep < 1) rep = 1;

  if (EdPendingKey(e, k, rep)) { e.count = 0; return; }

  // Numeric prefix ('0' alone is the line-start motion).
  if ((k >= '1' && k <= '9') || (k == '0' && e.count > 0)) {
    e.count = e.count * 10 + (k - '0');
    return;
  }

  if (EdMotionKey(e, k, rep, e.count > 0)) { e.count = 0; return; }

  I64 i = 0;

  // -- pending starters --
  if (k == 'd') { e.pending = "d"; return; }   // keep count for d<motion>
  else if (k == 'y') { e.pending = "y"; return; }
  else if (k == 'c') { e.pending = "c"; return; }
  else if (k == 'g') { e.pending = "g"; return; }
  else if (k == 'r') { e.pending = "r"; return; }
  else if (k == 'Z') { e.pending = "Z"; return; }

  // -- visual mode --
  else if (k == 'v') {
    e.mode = M_VISUAL;
    e.vline = FALSE;
    e.vx = e.cx;
    e.vy = e.cy;
  }
  else if (k == 'V') {
    e.mode = M_VISUAL;
    e.vline = TRUE;
    e.vx = e.cx;
    e.vy = e.cy;
  }

  // -- edits --
  else if (k == 'x' || k == K_DEL) { EdDeleteChars(e, e.cx, rep); }
  else if (k == 'X') { if (e.cx > 0) EdDeleteChars(e, e.cx - rep, rep); }
  else if (k == 'D') {
    U8 line = EdCurLine(e);
    if (e.cx < Len(line)) EdDeleteChars(e, e.cx, Len(line) - e.cx);
  }
  else if (k == 'C') { EdOpMotion(e, "c", '$', 1); }
  else if (k == 'J') { for (i = 0; i < rep; ++i) EdJoin(e); }
  else if (k == 'p') { EdPaste(e, TRUE); }
  else if (k == 'P') { EdPaste(e, FALSE); }
  else if (k == 'u') { EdUndo(e); }

  // -- insert-mode entries --
  else if (k == 'i') { EdEnterInsert(e, e.cx); }
  else if (k == 'I') { EdEnterInsert(e, LineFirstNonBlank(EdCurLine(e))); }
  else if (k == 'a') {
    I64 ax = e.cx;
    if (Len(EdCurLine(e)) > 0) ax = e.cx + 1;
    EdEnterInsert(e, ax);
  }
  else if (k == 'A') { EdEnterInsert(e, Len(EdCurLine(e))); }
  else if (k == 'o') { EdOpenLine(e, TRUE); }
  else if (k == 'O') { EdOpenLine(e, FALSE); }

  // -- command line & search --
  else if (k == ':') { e.mode = M_CMD; e.cmdkind = ':'; e.cmd = ""; }
  else if (k == '/') { e.mode = M_CMD; e.cmdkind = '/'; e.cmd = ""; }
  else if (k == 'n') {
    if (!EdFind(e, e.search, TRUE)) EdSetStatus(e, "Pattern not found: " + e.search);
  }
  else if (k == 'N') {
    if (!EdFind(e, e.search, FALSE)) EdSetStatus(e, "Pattern not found: " + e.search);
  }

  else if (k == 3) { EdSetStatus(e, "Type :q<Enter> to quit"); }  // Ctrl-C
  else if (k == 27) { EdSetStatus(e, ""); }

  e.count = 0;
}
