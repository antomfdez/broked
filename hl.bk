// hl.bk - syntax highlighting for brokm (.bk) source.
//
// Per-line, stateless scan over the already-clipped visible text: line
// comments, string/char literals, numbers, keywords, and type names.
// Colors are zero-width escape codes, so cursor math is unaffected
// (the cursor is parked with an absolute ESC[r;cH).

#include "editor.bk"

U8 HL_RESET   = Chr(27) + "[39m";
U8 HL_COMMENT = Chr(27) + "[90m";
U8 HL_STRING  = Chr(27) + "[32m";
U8 HL_NUMBER  = Chr(27) + "[35m";
U8 HL_KEYWORD = Chr(27) + "[33m";
U8 HL_TYPE    = Chr(27) + "[36m";

U0 HL_KW = MapNew();
U0 HL_TY = MapNew();

U0 HlInit()
{
  U0[] kws = ["if", "else", "while", "for", "do", "return", "break",
              "continue", "switch", "case", "default", "class", "struct",
              "this"];
  U0[] tys = ["U0", "U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64",
              "F64", "Bool", "TRUE", "FALSE", "NULL"];
  I64 i = 0;
  for (i = 0; i < Len(kws); ++i) MapSet(HL_KW, kws[i], 1);
  for (i = 0; i < Len(tys); ++i) MapSet(HL_TY, tys[i], 1);
}

HlInit();

// One visible line, with color escapes spliced around tokens.
U8 HlLine(U8 s)
{
  U8 out = "";
  I64 n = Len(s);
  I64 i = 0;
  I64 plain = 0;   // start of the pending uncolored run
  while (i < n) {
    I64 c = CharAt(s, i);
    if (c == '/' && i + 1 < n && CharAt(s, i + 1) == '/') {
      out = out + Substr(s, plain, i - plain)
          + HL_COMMENT + Substr(s, i, n - i) + HL_RESET;
      return out;
    }
    if (c == '"' || c == '\'') {
      I64 j = i + 1;
      Bool open = TRUE;
      while (j < n && open) {
        I64 d = CharAt(s, j);
        if (d == '\\') j = j + 2;
        else if (d == c) { j = j + 1; open = FALSE; }
        else j = j + 1;
      }
      if (j > n) j = n;
      out = out + Substr(s, plain, i - plain)
          + HL_STRING + Substr(s, i, j - i) + HL_RESET;
      i = j;
      plain = i;
    } else if (c >= '0' && c <= '9'
               && (i == 0 || ChClass(CharAt(s, i - 1)) != 1)) {
      I64 j = i;
      while (j < n && (ChClass(CharAt(s, j)) == 1 || CharAt(s, j) == '.'))
        j = j + 1;
      out = out + Substr(s, plain, i - plain)
          + HL_NUMBER + Substr(s, i, j - i) + HL_RESET;
      i = j;
      plain = i;
    } else if (ChClass(c) == 1) {
      I64 j = i;
      while (j < n && ChClass(CharAt(s, j)) == 1) j = j + 1;
      U8 w = Substr(s, i, j - i);
      if (MapHas(HL_KW, w) || MapHas(HL_TY, w)) {
        U8 color = HL_KEYWORD;
        if (MapHas(HL_TY, w)) color = HL_TYPE;
        out = out + Substr(s, plain, i - plain) + color + w + HL_RESET;
        plain = j;
      }
      i = j;
    } else {
      i = i + 1;
    }
  }
  return out + Substr(s, plain, n - plain);
}
